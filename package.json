{
  "name": "hammerschlag",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Alle Grundstücksteigerungen der Schweiz aus dem SHAB, mit Bewertung und Renovationsrechner",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-daten.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "steigerungen": "node scripts/steigerungen.mjs",
    "steigerungen:bestand": "node scripts/steigerungen.mjs --tage 120",
    "demo-daten": "node scripts/demo-daten.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "fast-xml-parser": "^4.5.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
